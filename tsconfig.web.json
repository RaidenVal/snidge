{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/settings/src/env.d.ts",
    "src/renderer/**/*",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@settings/*": [
        "./src/renderer/settings/src/*"
      ],
      "@overlay/*": [
        "./src/renderer/overlay/src/*"
      ],
      "@palette/*": [
        "./src/renderer/palette/src/*"
      ],
      "@shared/*": [
        "./src/renderer/shared/*"
      ]
    }
  }
}
